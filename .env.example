# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV="development"

# MongoDB Connection String (MongoDB Atlas or local: mongodb://localhost:27017/blog_platform)
# If empty or disconnected, DevScribe automatically operates in persistent standalone mode.
MONGODB_URI="mongodb://localhost:27017/blog_platform"

# Secret key for signing and verifying JSON Web Tokens (JWT)
JWT_SECRET="devscribe_super_secret_jwt_key_2026_change_in_production"

# JWT Expiration duration (e.g. 7d, 24h, 1h)
JWT_EXPIRE="7d"
